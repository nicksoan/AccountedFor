@{
    var company = ViewData["Company"] as Company;
    var screenId = ViewData["ScreenId"] as string ?? "FID000";
    var title = ViewData["Title"] as string ?? "";
    var exit = ViewData["Exit"] as string ?? Navigation.MainMenu;
    var help = ViewData["HelpTopic"] as string ?? "BASICS";
    var error = ViewData["Error"] as string ?? TempData["Error"] as string;
    var message = TempData["Message"] as string;
    var levelUp = TempData["LevelUp"] as string;
    var pfKeys = ViewData["PfKeys"] as IEnumerable<PfKey> ?? [];
    var showCommandStep = ViewData["ShowCommandStep"] is true;
    var path = Context.Request.Path.Value;
    var level = company?.CurrentLevel;
    var guideLevel = company is null ? null : ViewData["GuideLevel"] as Level ??
        TrainingGuide.SelectedLevel(company, Context.Request.Cookies[TerminalPageModel.CookieName], Context.Request.Cookies[TrainingGuide.CookieName]);
    var disableCrt = Context.Request.Cookies[DisplayPreferences.DisableCrtCookie] == "1";
    var fontColor = DisplayPreferences.FontColorOrDefault(Context.Request.Cookies[DisplayPreferences.FontColorCookie]);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>FIDOS @screenId - @title | Accounted For</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<div class="workspace">
    <details id="guide" class="guide" data-remember-guide="@(company is not null ? "true" : null)">
        <summary><span class="mascot" aria-hidden="true">›_</span> Pixel · Terminal guide</summary>
        <aside class="guide-panel" aria-label="Accounted For guide">
        <p>Hi, I’m Pixel, your FIDOS terminal guide.</p>
        @if (company is null)
        {
            <p>Your sandbox is a private set of practice books. No password is needed. Once you sign on, I’ll show you how to open your first lesson.</p>
            <p><a href="/">Go to sign-on</a></p>
        }
        else
        {
            <nav class="guide-nav" aria-label="Workspace navigation">
                <a href="/Menu">Main menu</a>
                <a href="/Training">Training levels</a>
                <a href="/Help">Bookkeeping help</a>
            </nav>
            @if (string.Equals(path, "/Menu", StringComparison.OrdinalIgnoreCase) || string.Equals(path, "/Menu/MAIN", StringComparison.OrdinalIgnoreCase))
            {
                <p class="guide-tip"><strong>Try a command:</strong> type <code>LEVELS</code> in the command bar and press Enter to open training levels. You can also type a menu option number or click it.</p>
            }
            else if (string.Equals(path, "/Menu/TRN", StringComparison.OrdinalIgnoreCase))
            {
                <p class="guide-tip"><strong>Next:</strong> choose 1 TRAINING LEVELS, then select an unlocked lesson.</p>
            }
            else if (string.Equals(path, "/Training", StringComparison.OrdinalIgnoreCase))
            {
                <p class="guide-tip"><strong>Choose a lesson:</strong> select an unlocked mission to read its briefing. Its objectives will remain here while you work.</p>
            }
            @if (guideLevel is not null)
            {
                <section aria-labelledby="lesson-guide">
                    <h2 id="lesson-guide">Lesson @guideLevel.Number / @guideLevel.Title</h2>
                    <p>@guideLevel.Concept</p>
                    <ul class="guide-objectives">
                        @for (var i = 0; i < guideLevel.Objectives.Count; i++)
                        {
                            var objective = guideLevel.Objectives[i];
                            var met = objective.IsMet(company);
                            var url = TrainingGuide.ObjectiveUrl(guideLevel.Number, i);
                            <li>
                                <span>@(met ? "✓ Complete" : "○ To do")</span>
                                @objective.Text
                                @if (!met && url is not null) { <a href="@url">Open screen</a> }
                            </li>
                        }
                    </ul>
                    <details>
                        <summary>Show lesson hints</summary>
                        @foreach (var hint in guideLevel.Hints) { <p>@hint</p> }
                    </details>
                    <p><a href="/Training/Level/@guideLevel.Number">Return to lesson briefing</a></p>
                    @if (level is not null && level.Number != guideLevel.Number)
                    {
                        <p><a href="/Training/Level/@level.Number">Continue to current lesson @level.Number</a></p>
                    }
                    else if (company.IsLevelComplete(guideLevel.Number) && level is null)
                    {
                        <p>All lessons complete. You can continue exploring freely.</p>
                    }
                </section>
            }
            else
            {
                <p>All lessons complete. <a href="/Training">Review training levels</a> or explore freely.</p>
            }
            <p class="guide-tip">Need your bearings? F12 returns to the main menu; F3 exits the current screen. You can also click the PF key labels below the terminal.</p>
        }
        </aside>
    </details>
<div class="crt @(disableCrt ? "no-crt" : null) theme-@fontColor">
    <div id="terminal" class="terminal">
        <div class="row head">
            <span><span class="hi">FIDOS</span> <span class="cy">@screenId</span></span>
            <span class="title">@title</span>
            <span id="clock" class="cy">@DateTime.Now.ToString("yyyy-MM-dd HH:mm")</span>
        </div>
        @if (company is not null)
        {
            <div class="row sub">
                <span>CO: <span class="wh">@company.Name</span>  OPR: <span class="wh">@company.OperatorId</span></span>
                <span>RANK: <span class="ye">@company.Rank</span>  SCORE: <span class="ye">@company.Score</span></span>
                <span>@if (level is not null)
                    {
                        <a href="/Training/Level/@level.Number">LVL @level.Number: @level.Title</a>
                    }
                    else
                    {
                        <span class="ye">TRAINING COMPLETE</span>
                    }</span>
            </div>
            <form method="get" action="/Command" class="row cmd" autocomplete="off">
                <label for="cmd" class="cy">COMMAND ===&gt;</label>
                <input id="cmd" name="cmd" class="fld cmdfld @(showCommandStep ? "coach-field" : null)"
                       maxlength="20" spellcheck="false" enterkeyhint="go" aria-describedby="@(showCommandStep ? "command-step" : null)" />
                <input type="hidden" name="from" value="@path" />
            </form>
            @if (showCommandStep)
            {
                <p id="command-step" class="coach-tip">
                    <strong>Pixel · Step 2 of 2</strong>
                    <span>Type <code>LEVELS</code> in the command bar above, then press Enter to open your training levels.</span>
                </p>
            }
        }
        <div class="rule"></div>
        <main>
            @RenderBody()
        </main>
        <div class="rule"></div>
        <div class="row msg" role="status" aria-live="polite">
            @if (!string.IsNullOrEmpty(levelUp))
            {
                <div class="levelup">@levelUp</div>
            }
            @if (!string.IsNullOrEmpty(error))
            {
                <div class="err">FID999E @error</div>
            }
            else if (!string.IsNullOrEmpty(message))
            {
                <div class="ok">@message</div>
            }
            else
            {
                <div class="dim">READY</div>
            }
        </div>
        <nav class="row pf">
            <a data-pf="F1" href="/Help?topic=@help">F1=HELP</a>
            @if (company is not null)
            {
                <a data-pf="F3" href="@exit">F3=EXIT</a>
                @foreach (var key in pfKeys)
                {
                    <a data-pf="@key.Key" href="@key.Url">@key.Key=@key.Label</a>
                }
                <a data-pf="F12" href="@Navigation.MainMenu">F12=MAIN</a>
            }
            <span class="dim">ENTER=PROCESS</span>
        </nav>
    </div>
</div>
</div>
<datalist id="accounts">
    @if (company is not null)
    {
        foreach (var a in company.Accounts)
        {
            <option value="@a.Code" label="@a.Name">@a.Name</option>
        }
    }
</datalist>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
