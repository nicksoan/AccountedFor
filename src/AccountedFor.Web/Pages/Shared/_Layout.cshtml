@{
    var company = ViewData["Company"] as Company;
    var screenId = ViewData["ScreenId"] as string ?? "FID000";
    var title = ViewData["Title"] as string ?? "";
    var exit = ViewData["Exit"] as string ?? Navigation.MainMenu;
    var help = ViewData["HelpTopic"] as string ?? "BASICS";
    var error = ViewData["Error"] as string ?? TempData["Error"] as string;
    var message = TempData["Message"] as string;
    var levelUp = TempData["LevelUp"] as string;
    var pfKeys = ViewData["PfKeys"] as IEnumerable<PfKey> ?? [];
    var showCommandStep = ViewData["ShowCommandStep"] is true;
    var path = Context.Request.Path.Value;
    var level = company?.CurrentLevel;
    var guideLevel = company is null ? null : ViewData["GuideLevel"] as Level ??
        TrainingGuide.SelectedLevel(company, Context.Request.Cookies[TerminalPageModel.CookieName], Context.Request.Cookies[TrainingGuide.CookieName]);
    var nextObjective = guideLevel?.Objectives.Select((objective, index) => new { objective, index })
        .FirstOrDefault(item => !item.objective.IsMet(company!));
    var disableCrt = Context.Request.Cookies[DisplayPreferences.DisableCrtCookie] == "1";
    var fontColor = DisplayPreferences.FontColorOrDefault(Context.Request.Cookies[DisplayPreferences.FontColorCookie]);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>FIDOS @screenId - @title | Accounted For</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header class="task-bar">
    <details class="task-log" data-remember-guide="true">
        <summary aria-label="Task log">
            <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="4" y="3" width="16" height="18" rx="2" />
                <path d="M8 8h1m3 0h5M8 12h1m3 0h5M8 16h1m3 0h5" />
            </svg>
            <span>Task log</span>
        </summary>
        <div class="task-log-panel guide">
            @if (company is null)
            {
                <p><a href="/">Sign on</a> to see your tutorial tasks.</p>
            }
            else
            {
                <nav class="guide-nav" aria-label="Workspace navigation">
                    <a href="/Menu">Main menu</a>
                    <a href="/Training">Training levels</a>
                    <a href="/Help">Accounting fundamentals</a>
                </nav>
                @if (guideLevel is not null)
                {
                    <section aria-labelledby="lesson-guide">
                        <h2 id="lesson-guide">Tutorial level @guideLevel.Number / @guideLevel.Title</h2>
                        <p>@guideLevel.Concept</p>
                        <p>@guideLevel.Objectives.Count(o => o.IsMet(company)) / @guideLevel.Objectives.Count objectives complete</p>
                        <details>
                            <summary>Show lesson briefing</summary>
                            @foreach (var line in guideLevel.Briefing) { <p>@line</p> }
                        </details>
                        <ul class="guide-objectives">
                            @for (var i = 0; i < guideLevel.Objectives.Count; i++)
                            {
                                var objective = guideLevel.Objectives[i];
                                var met = objective.IsMet(company);
                                var url = TrainingGuide.ObjectiveUrl(guideLevel.Number, i);
                                <li>
                                    <span>@(met ? "✓ Complete" : "○ To do")</span>
                                    @objective.Text
                                    @if (!met && url is not null) { <a href="@url">Open screen</a> }
                                </li>
                            }
                        </ul>
                        <details>
                            <summary>Show lesson hints</summary>
                            @foreach (var hint in guideLevel.Hints) { <p>@hint</p> }
                        </details>
                        <p><a href="/Training/Level/@guideLevel.Number">Return to lesson briefing</a></p>
                        @if (level is not null && level.Number != guideLevel.Number)
                        {
                            <p><a href="/Training/Level/@level.Number">Continue to current lesson @level.Number</a></p>
                        }
                        else if (company.IsLevelComplete(guideLevel.Number) && level is null)
                        {
                            <p>All lessons complete. You can continue exploring freely.</p>
                        }
                    </section>
                }
                else
                {
                    <p>All lessons complete. <a href="/Training">Review training levels</a> or explore freely.</p>
                }
                <p>Type <code>HELP</code> in COMMAND for accounting fundamentals. F12 returns to the main menu; F3 exits the current screen. You can also click the PF key labels below the terminal.</p>
            }
        </div>
    </details>
</header>
<div class="workspace">
    <aside id="guide" class="guide" aria-label="Accounted For guide">
        <div class="guide-heading"><span class="mascot" aria-hidden="true">›_</span> Pixel · Terminal guide</div>
        @if (company is null)
        {
            @if (screenId == "FIDLOGON")
            {
                <p class="guide-tip"><strong>Step 1 · Sign on</strong><br />Enter a USERID below. No password is needed; your practice books stay in your own sandbox.</p>
            }
            else
            {
                <p class="guide-tip"><a href="/">Go to sign-on</a> to open your practice books.</p>
            }
        }
        else
        {
            @if (string.Equals(path, "/Menu", StringComparison.OrdinalIgnoreCase) || string.Equals(path, "/Menu/MAIN", StringComparison.OrdinalIgnoreCase))
            {
                <p class="guide-tip"><strong>Step 2 · Use the command bar</strong><br />This is the main menu. Type <code>5</code> in COMMAND and press Enter to open Tutorial, or click the menu option.</p>
            }
            else if (string.Equals(path, "/Menu/TRN", StringComparison.OrdinalIgnoreCase))
            {
                <p class="guide-tip"><strong>Next · Open training</strong><br />Type <code>1</code> in COMMAND and press Enter to open TRAINING LEVELS, or click the menu option.</p>
            }
            else if (string.Equals(path?.TrimEnd('/'), "/Training", StringComparison.OrdinalIgnoreCase))
            {
                <p class="guide-tip"><strong>Step 3 · Choose a lesson</strong><br />Select an unlocked mission to read its briefing and objectives.</p>
            }
            else if (path?.StartsWith("/Training/Level/", StringComparison.OrdinalIgnoreCase) == true)
            {
                @if (ViewData["GuideLevel"] is null)
                {
                    <p class="guide-tip"><strong>Lesson locked</strong><br />Complete earlier lessons first. <a href="/Training">Choose an unlocked lesson</a>.</p>
                }
                else if (nextObjective is not null)
                {
                    <p class="guide-tip"><strong>Step 4 · Start your mission</strong><br />Read the briefing, then: @nextObjective.objective.Text
                        @if (TrainingGuide.ObjectiveUrl(guideLevel!.Number, nextObjective.index) is string nextUrl) { <a href="@nextUrl">Open screen</a> }
                    </p>
                }
                else
                {
                    <p class="guide-tip"><strong>Mission complete</strong><br /><a href="/Training">Choose another lesson</a> or explore the terminal freely.</p>
                }
            }
            else if (nextObjective is not null)
            {
                <p class="guide-tip"><strong>Next · Lesson @guideLevel!.Number</strong><br />@nextObjective.objective.Text
                    @if (TrainingGuide.ObjectiveUrl(guideLevel.Number, nextObjective.index) is string nextUrl && !string.Equals(path?.TrimEnd('/'), nextUrl, StringComparison.OrdinalIgnoreCase)) { <a href="@nextUrl">Open screen</a> }
                </p>
            }
            else
            {
                <p class="guide-tip"><strong>Next · Training</strong><br /><a href="/Training">Choose a lesson</a> or explore the terminal freely.</p>
            }

        }
    </aside>
<div class="crt @(disableCrt ? "no-crt" : null) theme-@fontColor">
    <div id="terminal" class="terminal">
        <div class="row head">
            <span><span class="hi">FIDOS</span> <span class="cy">@screenId</span></span>
            <span class="title">@title</span>
            <span id="clock" class="cy">@DateTime.Now.ToString("yyyy-MM-dd HH:mm")</span>
        </div>
        @if (company is not null)
        {
            <div class="row sub">
                <span>CO: <span class="wh">@company.Name</span>  OPR: <span class="wh">@company.OperatorId</span></span>
                <span>RANK: <span class="ye">@company.Rank</span>  SCORE: <span class="ye">@company.Score</span></span>
                <span>@if (level is not null)
                    {
                        <a href="/Training/Level/@level.Number">LVL @level.Number: @level.Title</a>
                    }
                    else
                    {
                        <span class="ye">TRAINING COMPLETE</span>
                    }</span>
            </div>
            <form method="get" action="/Command" class="row cmd" autocomplete="off">
                <label for="cmd" class="cy">COMMAND ===&gt;</label>
                <input id="cmd" name="cmd" class="fld cmdfld @(showCommandStep ? "coach-field" : null)"
                       maxlength="20" spellcheck="false" enterkeyhint="go" aria-describedby="@(showCommandStep ? "command-step" : null)" />
                <input type="hidden" name="from" value="@path" />
            </form>
            @if (showCommandStep)
            {
                <p id="command-step" class="coach-tip">
                    <strong>Pixel · Step 2 of 4</strong>
                    <span>Type <code>5</code> in the command bar above, then press Enter to open Tutorial. Next, choose 1 for training levels.</span>
                </p>
            }
        }
        <div class="rule"></div>
        <main>
            @RenderBody()
        </main>
        <div class="rule"></div>
        <div class="row msg" role="status" aria-live="polite">
            @if (!string.IsNullOrEmpty(levelUp))
            {
                <div class="levelup">@levelUp</div>
            }
            @if (!string.IsNullOrEmpty(error))
            {
                <div class="err">FID999E @error</div>
            }
            else if (!string.IsNullOrEmpty(message))
            {
                <div class="ok">@message</div>
            }
            else
            {
                <div class="dim">READY</div>
            }
        </div>
        <nav class="row pf">
            <a data-pf="F1" href="/Help?topic=@help">F1=HELP</a>
            @if (company is not null)
            {
                <a data-pf="F3" href="@exit">F3=EXIT</a>
                @foreach (var key in pfKeys)
                {
                    <a data-pf="@key.Key" href="@key.Url">@key.Key=@key.Label</a>
                }
                <a data-pf="F12" href="@Navigation.MainMenu">F12=MAIN</a>
            }
            <span class="dim">ENTER=PROCESS</span>
        </nav>
    </div>
</div>
</div>
<datalist id="accounts">
    @if (company is not null)
    {
        foreach (var a in company.Accounts)
        {
            <option value="@a.Code" label="@a.Name">@a.Name</option>
        }
    }
</datalist>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
