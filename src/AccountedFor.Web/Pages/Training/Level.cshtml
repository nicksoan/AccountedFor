@page "{number:int}"
@model LevelModel
@{
    var l = Model.Level;
    var c = Model.Company;
    ViewData["ScreenId"] = $"TR1{l.Number:00}";
    ViewData["Title"] = $"LEVEL {l.Number}: {l.Title}";
    ViewData["Exit"] = "/Training";
    ViewData["HelpTopic"] = "LEVELS";
    var done = c.IsLevelComplete(l.Number);
}
<h2>LEVEL @l.Number - @l.Title <span class="dim">(@l.Concept, @l.Points PTS)</span></h2>
@if (!c.IsLevelUnlocked(l.Number))
{
    <div class="box warn">LOCKED - COMPLETE LEVEL @(l.Number - 1) FIRST. YOU CAN STILL READ THE BRIEFING.</div>
}
else if (done)
{
    <div class="box good">MISSION COMPLETE @c.CompletedLevels[l.Number].ToString("yyyy-MM-dd HH:mm") UTC.</div>
}
@if (l.Scenarios.Count > 0 && c.IsLevelUnlocked(l.Number))
{
    var activeScenarioIndex = l.Scenarios
        .Select((scenario, index) => new { scenario, index })
        .FirstOrDefault(item => !l.Objectives[item.scenario.ObjectiveIndex].IsMet(c))?.index ?? -1;
    <details>
        <summary class="cy">LESSON BACKGROUND</summary>
        @foreach (var line in l.Briefing)
        {
            <p class="wh">@line</p>
        }
    </details>
    <h2 class="cy">GUIDED SCENARIOS</h2>
    <ol class="guide-scenarios">
        @for (var i = 0; i < l.Scenarios.Count; i++)
        {
            var scenario = l.Scenarios[i];
            var complete = l.Objectives[scenario.ObjectiveIndex].IsMet(c);
            var available = i == activeScenarioIndex;
            var url = TrainingGuide.ObjectiveUrl(l.Number, scenario.ObjectiveIndex);
            <li>
                <h3>SCENARIO @(i + 1) <span class="dim">@(complete ? "COMPLETE" : available ? "YOUR TURN" : "UP NEXT")</span></h3>
                @if (available || complete)
                {
                    <p class="wh">@scenario.Situation</p>
                    <p>@scenario.Teaching</p>
                    <ol>
                        @foreach (var instruction in scenario.Instructions)
                        {
                            <li>@instruction</li>
                        }
                    </ol>
                    @if (available && url is not null)
                    {
                        <a class="btn" href="@url">OPEN THE SCREEN</a>
                    }
                }
                else if (!complete)
                {
                    <p class="dim">Complete the previous scenario to continue.</p>
                }
            </li>
        }
    </ol>
}
else
{
    <p class="cy">BRIEFING</p>
    @foreach (var line in l.Briefing)
    {
        <p class="wh">@line</p>
    }
}
@if (l.Number == 2)
{
    var sale = PracticeCatalog.All[1];
    <div class="actions">
        <button type="button" class="btn" id="cutscene-open" hidden>WATCH THE SALE: A DEAD CLIC STORY</button>
    </div>
    <dialog id="sale-cutscene" class="cutscene" aria-labelledby="cutscene-title">
        <div class="cutscene-header">
            <h2 id="cutscene-title">DEAD CLIC / A SALE IN TWO SIDES</h2>
            <button type="button" data-cutscene-close aria-label="Close cutscene">X CLOSE</button>
        </div>
        <p class="cutscene-kicker">FIDOS TELETEXT · AN EXAMPLE, NOT A POSTING</p>
        <div class="cutscene-slides">
            <section class="cutscene-slide" aria-label="Scene 1 of 3">
                <h3>01 / THE CUSTOMER</h3>
                <div class="teletext-art shop-art" aria-hidden="true">
                    <div class="shop-sign">NORTHSEA SHOP</div>
                    <div class="shop-window"><span class="customer">█<br />▓▓<br />█ █</span><span class="goods">▟██▙<br />GOODS</span><span class="clerk">█<br />▓▓<br />█ █</span></div>
                    <div class="counter">████████████████████</div>
                </div>
                <p>A customer buys goods for £@sale.Amount.ToString("0.00"). Ignore VAT in this example.</p>
            </section>
            <section class="cutscene-slide" aria-label="Scene 2 of 3" hidden>
                <h3>02 / THE PAYMENT</h3>
                <div class="teletext-art payment-art" aria-hidden="true">
                    <span>CUSTOMER</span><span class="payment-arrow">£@sale.Amount.ToString("0.00") ▰▰▶</span><span>BANK</span>
                </div>
                <p>The customer pays by bank transfer right away. The business has more money in its bank account.</p>
            </section>
            <section class="cutscene-slide" aria-label="Scene 3 of 3" hidden>
                <h3>03 / THE LEDGERS</h3>
                <div class="cutscene-ledgers">
                    <div><strong>@sale.DebitCode BANK / ASSET</strong><div class="ledger-columns"><span>DEBIT (LEFT)<br />£@sale.Amount.ToString("0.00")</span><span>CREDIT (RIGHT)<br />—</span></div></div>
                    <div><strong>@sale.CreditCode SALES / INCOME</strong><div class="ledger-columns"><span>DEBIT (LEFT)<br />—</span><span>CREDIT (RIGHT)<br />£@sale.Amount.ToString("0.00")</span></div></div>
                </div>
                <p>Debit Bank: assets increase on the debit side. Credit Sales: income increases on the credit side.</p>
                <p>Both sides are £@sale.Amount.ToString("0.00"): the entry balances. DEAD = debit increases assets; CLIC = credit increases income.</p>
            </section>
        </div>
        <div class="cutscene-controls">
            <button type="button" data-cutscene-prev>PREVIOUS</button>
            <button type="button" data-cutscene-next>NEXT</button>
            <button type="button" data-cutscene-play>PAUSE</button>
            <button type="button" data-cutscene-replay>REPLAY</button>
            <span data-cutscene-status aria-live="polite"></span>
        </div>
    </dialog>
}
@if (l.Scenarios.Count == 0 || !c.IsLevelUnlocked(l.Number))
{
    <p class="cy">OBJECTIVES</p>
    @if (l.Number == 2 && c.IsLevelUnlocked(2))
    {
        <p>Start with a small investment, then post a sale and an expense. You'll see what each posting changes in the practice ledgers.</p>
        <div class="actions"><a class="btn" asp-page="./Practice">OPEN PRACTICE BOOKS</a></div>
    }
    <table class="grid">
        @for (var i = 0; i < l.Objectives.Count; i++)
        {
            var o = l.Objectives[i];
            var met = o.IsMet(c);
            var url = TrainingGuide.ObjectiveUrl(l.Number, i);
            <tr>
                <td>@(met ? "[X]" : "[ ]")</td>
                <td class="@(met ? "good" : "")">
                    @if (l.Number != 2 && c.IsLevelUnlocked(l.Number) && !met && url is not null)
                    {
                        <a class="objective-link" href="@url">@o.Text</a>
                    }
                    else
                    {
                        @o.Text
                    }
                </td>
            </tr>
        }
    </table>
}
<details>
    <summary class="ye">HINTS (CLICK TO REVEAL)</summary>
    @foreach (var h in l.Hints)
    {
        <p>- @h</p>
    }
</details>
<div class="actions">
    @if (l.Number > 1) { <a class="btn" href="/Training/Level/@(l.Number - 1)" data-pf="F7">F7=PREV LEVEL</a> }
    @if (l.Number < LevelCatalog.All.Count) { <a class="btn" href="/Training/Level/@(l.Number + 1)" data-pf="F8">F8=NEXT LEVEL</a> }
</div>
@section Scripts {
    @if (l.Number == 2)
    {
        <script src="~/js/sale-cutscene.js" asp-append-version="true"></script>
    }
}
