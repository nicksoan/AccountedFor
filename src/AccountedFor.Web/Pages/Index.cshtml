@page
@model IndexModel
@{
    ViewData["ScreenId"] = "FIDLOGON";
    ViewData["Title"] = "SIGN ON";
    ViewData["HelpTopic"] = "NAV";
}
<pre class="banner" aria-label="FIDOS">
  ███████╗██╗██████╗  ██████╗ ███████╗
  ██╔════╝██║██╔══██╗██╔═══██╗██╔════╝
  █████╗  ██║██║  ██║██║   ██║███████╗
  ██╔══╝  ██║██║  ██║██║   ██║╚════██║
  ██║     ██║██████╔╝╚██████╔╝███████║
  ╚═╝     ╚═╝╚═════╝  ╚═════╝ ╚══════╝
</pre>
<p class="wh">NORTHSEA - FIDOS ENTERPRISE RESOURCE PLANNING</p>
<p class="cy">ACCOUNTED FOR: A DOUBLE-ENTRY BOOKKEEPING TRAINING SANDBOX</p>
<div class="rule"></div>
<p class="ye">THIS IS A TRAINING SYSTEM. EVERYTHING YOU POST LIVES IN YOUR OWN PRIVATE SANDBOX.</p>
<p class="dim">DO NOT ENTER REAL OR PERSONAL FINANCIAL DATA.</p>

<form method="post" autocomplete="off">
    <p id="signon-step" class="coach-tip">
        <strong>Pixel · Step 1 of 4</strong>
        @if (Model.Existing is not null)
        {
            <span>Welcome back, @Model.Existing.OperatorId! Press Enter to sign on and reopen your practice books.</span>
        }
        else
        {
            <span>To get started, type your name or initials (1–8 letters or digits), then press Enter to create your sandbox.</span>
        }
    </p>
    <label for="op" class="cy">USERID ===&gt;</label>
    <input id="op" class="fld w10 coach-field" asp-for="OperatorId" maxlength="8" spellcheck="false"
           enterkeyhint="go" aria-describedby="signon-step" autofocus />
    <div class="actions"><button type="submit" class="btn">ENTER=LOGON</button></div>
</form>
