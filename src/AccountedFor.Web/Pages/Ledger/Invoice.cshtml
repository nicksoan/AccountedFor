@page "/{ledger:regex(^(ar|ap)$)}/invoice"
@model InvoiceModel
@{
    var k = Model.Kind;
    ViewData["ScreenId"] = $"{k.Code}300";
    ViewData["Title"] = k.InvoiceTitle;
    ViewData["PfKeys"] = new[] { new PfKey("F5", k.Parties, k.Url("parties")), new PfKey("F6", "NEW " + k.Party, k.Url("parties/new")) };
    var parties = k.PartyList(Model.Company);
    var accounts = Model.Company.Accounts.Where(k.AllowsLineAccount).ToList();
}
<p class="cy">POSTS: @k.InvoiceDoubleEntry</p>
@if (parties.Count == 0)
{
    <div class="box warn">YOU NEED A @k.Party FIRST. <a href="@k.Url("parties/new")">CREATE ONE (F6)</a>.</div>
}
else
{
    <form method="post" autocomplete="off">
        <table class="form">
            <tr>
                <td class="lbl"><label for="party">@k.Party</label><span class="dots"></span></td>
                <td><select id="party" class="fld" asp-for="Party">
                    @foreach (var p in parties) { <option value="@p.Id">@p.Id - @p.Name</option> }
                </select></td>
            </tr>
            <tr>
                <td class="lbl"><label for="date">INVOICE DATE</label><span class="dots"></span></td>
                <td><input id="date" class="fld w10" asp-for="Date" maxlength="10" /> <span class="dim">YYYY-MM-DD</span></td>
            </tr>
            <tr>
                <td class="lbl"><label for="ref">@(k.IsReceivables ? "CUSTOMER PO / REF" : "SUPPLIER INVOICE NO")</label><span class="dots"></span></td>
                <td><input id="ref" class="fld w14" asp-for="Reference" maxlength="20" /> <span class="dim">OPTIONAL</span></td>
            </tr>
            <tr>
                <td class="lbl"><label for="vat">VAT RATE %</label><span class="dots"></span></td>
                <td><input id="vat" class="fld w4 num" asp-for="VatRate" maxlength="6" /> <span class="dim">0 IF NOT VAT REGISTERED</span></td>
            </tr>
        </table>
        <table class="grid">
            <thead><tr><th>LN</th><th>ACCT</th><th>ACCOUNT NAME</th><th>DESCRIPTION</th><th class="n">NET AMOUNT</th></tr></thead>
            <tbody>
            @for (var i = 0; i < Model.Lines.Count; i++)
            {
                <tr>
                    <td class="dim">@((i + 1).ToString("00"))</td>
                    <td><input class="fld w4" name="Lines[@i].Account" value="@Model.Lines[i].Account" maxlength="4" list="lineaccts" data-name="ln@(i)" aria-label="LINE @(i + 1) ACCOUNT" /></td>
                    <td id="ln@(i)" class="cy">@Model.Company.FindAccount(Model.Lines[i].Account)?.Name</td>
                    <td><input class="fld w30" name="Lines[@i].Description" value="@Model.Lines[i].Description" maxlength="40" aria-label="LINE @(i + 1) DESCRIPTION" /></td>
                    <td><input class="fld w12 num" name="Lines[@i].Net" value="@Model.Lines[i].Net" maxlength="15" aria-label="LINE @(i + 1) NET AMOUNT" /></td>
                </tr>
            }
            </tbody>
        </table>
        <datalist id="lineaccts">
            @foreach (var a in accounts) { <option value="@a.Code" label="@a.Name">@a.Name</option> }
        </datalist>
        <p class="dim">LINE ACCOUNTS: @k.LineAccountRule (E.G. @string.Join(", ", accounts.Take(4).Select(a => a.Code + " " + a.Name)))</p>
        <div class="actions"><button type="submit" class="btn">ENTER=POST INVOICE</button></div>
    </form>
}
